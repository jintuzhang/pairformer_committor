# vim:ft=plumed
LOAD FILE=../../../plumed_pytorch_pairformer/PytorchPairFormerExported.cpp

MOLINFO STRUCTURE=../../data/plumed_topo.pdb PYTHON_BIN=python
GROUP ATOMS={@mdt:{protein and not type H}} LABEL=g1

phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
theta: TORSION ATOMS=6,5,7,9

PYTORCH_PAIRFORMER_EXPORTED ...
  GROUPA=g1
  MODEL=../../train/model.pt2
  STRUCTURE=../../data/plumed_topo.pdb
  LABEL=pf
  NOPBC
... PYTORCH_PAIRFORMER_EXPORTED

OPES_METAD ...
  LABEL=opes
  ARG=pf.node-0
  FILE=KERNELS
  STATE_RFILE=COMPRESSED.KERNELS
  STATE_WFILE=COMPRESSED.KERNELS
  STATE_WSTRIDE=1000000
  PACE=500
  TEMP=300
  BARRIER=40
... OPES_METAD

PRINT ARG=* FILE=colvar STRIDE=500
