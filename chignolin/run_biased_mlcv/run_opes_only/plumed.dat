# vim: ft=plumed

MOLINFO STRUCTURE=../../data/gmx/plumed_topo.pdb PYTHON_BIN=python
GROUP ATOMS={@mdt:{protein and backbone and not type H}} LABEL=g1

WHOLEMOLECULES ENTITY0=1-166

DISTANCE ATOMS=5,147 NOPBC LABEL=d_ee
DISTANCE ATOMS=45,106 NOPBC LABEL=d_asp3n_gly7o
DISTANCE ATOMS=45,120 NOPBC LABEL=d_asp3n_thr8o
RMSD REFERENCE=../../data/gmx/rmsd_ref_ca.pdb TYPE=OPTIMAL LABEL=r_ca

DISTANCE ATOMS=23,144 NOPBC LABEL=d1
DISTANCE ATOMS=56,107 NOPBC LABEL=d2
DISTANCE ATOMS=24,164 NOPBC LABEL=d3
DISTANCE ATOMS=1,120  NOPBC LABEL=d4
DISTANCE ATOMS=23,165 NOPBC LABEL=d5
DISTANCE ATOMS=85,165 NOPBC LABEL=d6
DISTANCE ATOMS=56,106 NOPBC LABEL=d7

MATHEVAL ...
    LABEL=z_fitted
    ARG=d1,d2,d3,d4,d5,d6,d7
    VAR=d1,d2,d3,d4,d5,d6,d7
    FUNC=0.53*d1+0.40*d2+0.21*d3+0.21*d4+0.12*d5-0.11*d6+0.02*d7
    PERIODIC=NO
... MATHEVAL

OPES_METAD ...
    LABEL=opes
    ARG=z_fitted
    FILE=KERNELS
    STATE_RFILE=COMPRESSED.KERNELS
    STATE_WFILE=COMPRESSED.KERNELS
    STATE_WSTRIDE=1000000
    PACE=500
    TEMP=340
    BARRIER=30
... OPES_METAD

PRINT ARG=* STRIDE=5000 FILE=colvar
