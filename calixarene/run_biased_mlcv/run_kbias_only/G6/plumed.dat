# vim: ft=plumed

LOAD FILE=../../../../plumed_pytorch_pairformer/PytorchPairFormerExported.so

FLUSH STRIDE=2000
MOLINFO STRUCTURE=../../../data/G6/plumed_topo.pdb PYTHON_BIN=python

HOST: GROUP ATOMS=17-212
LIGC: GROUP ATOMS=4-10
WO: GROUP ATOMS=222-6521:3

GROUP ATOMS={@mdt:{(resname G2 G5 G6 and not type H) or (resname OCB and name C1 C10 C16 C28 C8 C18 C26 C32 C46 C52 C58 C64)}} LABEL=g1
GROUP ATOMS={@mdt:{resname OCB and name C1 C10 C16 C28}} LABEL=g2
GROUP ATOMS={@mdt:{resname OCB and name C8 C18 C26 C32}} LABEL=g3
GROUP ATOMS={@mdt:{resname OCB and name C46 C52 C58 C64}} LABEL=g4

WHOLEMOLECULES ENTITY0=HOST

PYTORCH_PAIRFORMER_EXPORTED ...
  GROUPA=g1
  GROUPB=WO
  GROUPC0=g2
  GROUPC1=g3
  GROUPC2=g4
  MODEL=../../../train/model.k_bias.pt2
  STRUCTURE=../../../data/G6/plumed_topo_pairformer.pdb
  NL_STRIDE=1
  IGNORE_EXCESSED_NL_ATOMS
  GRADIENT_THRESHOLD=200
  LABEL=pf
... PYTORCH_PAIRFORMER_EXPORTED

FIT_TO_TEMPLATE STRIDE=1 REFERENCE=../../../data/G6/conf_template.pdb TYPE=OPTIMAL
lig: CENTER ATOMS=LIGC

v1: FIXEDATOM AT=2.0136,2.0136,2.0
v2: FIXEDATOM AT=2.0136,2.0136,2.25
v3: FIXEDATOM AT=2.0136,2.0136,2.5
v4: FIXEDATOM AT=2.0136,2.0136,2.75
v5: FIXEDATOM AT=2.0136,2.0136,3.0
v6: FIXEDATOM AT=2.0136,2.0136,3.25
v7: FIXEDATOM AT=2.0136,2.0136,3.5
v8: FIXEDATOM AT=2.0136,2.0136,3.75

V1: COORDINATION GROUPA=v1 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V2: COORDINATION GROUPA=v2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V3: COORDINATION GROUPA=v3 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V4: COORDINATION GROUPA=v4 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V5: COORDINATION GROUPA=v5 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V6: COORDINATION GROUPA=v6 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V7: COORDINATION GROUPA=v7 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5
V8: COORDINATION GROUPA=v8 GROUPB=WO SWITCH={RATIONAL D_0=0.0 D_MAX=1.0 R_0=0.25 NN=2 MM=6} NLIST NL_CUTOFF=1.0 NL_STRIDE=5

cyl: DISTANCE ATOMS=v1,lig COMPONENTS
radius: MATHEVAL ARG=cyl.x,cyl.y FUNC=sqrt(x*x+y*y) PERIODIC=NO

funnel: MATHEVAL ARG=radius,cyl.z VAR=r,z FUNC=(r+1.0*(-1.2+z))*step(-z+1.)+(r-0.2)*step(z-1.) PERIODIC=NO
UPPER_WALLS AT=0 ARG=funnel KAPPA=2000.0 LABEL=w_f
UPPER_WALLS AT=1.8 ARG=cyl.z KAPPA=4000.0 EXP=2 LABEL=w_1

ang: ANGLE ATOMS=v3,v5,6,10
cosang: MATHEVAL ARG=ang FUNC=cos(x) PERIODIC=NO

BIASVALUE ARG=pf.kbias LABEL=v_k

PRINT ARG=* STRIDE=500 FILE=colvar
